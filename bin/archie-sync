#!/usr/bin/env python3
"""archie-sync — sync the current git repo's submodules from anywhere.

Thin launcher: locates miconfig's sync script via this file's own path (so it
works through a symlink in ~/.local/bin) and forwards every argument to it.
The sync itself acts on whatever repo the current directory belongs to.
"""

import subprocess
import sys
from pathlib import Path

# Resolve through symlinks so this works from ~/.local/bin or anywhere else
REPO_ROOT = Path(__file__).resolve().parent.parent
SYNC_SCRIPT = REPO_ROOT / "sync-submodules.py"


def main() -> None:
    if not SYNC_SCRIPT.exists():
        sys.exit(f"Error: sync script not found at {SYNC_SCRIPT}")
    # cwd is inherited deliberately: the sync targets the caller's repo.
    result = subprocess.run([sys.executable, str(SYNC_SCRIPT), *sys.argv[1:]])
    sys.exit(result.returncode)


if __name__ == "__main__":
    main()
