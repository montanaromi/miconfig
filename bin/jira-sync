#!/usr/bin/env python3
"""Two-way sync between daily journal todos and Jira OSMR board."""

import argparse
import json
import re
import subprocess
import sys
from datetime import date, timedelta
from pathlib import Path
from urllib.request import Request, urlopen
from urllib.error import HTTPError
from urllib.parse import quote
from base64 import b64encode

JIRA_BASE = "https://blitzy.atlassian.net"
JIRA_PROJECT = "OSMR"
KEYCHAIN_SERVICE = "jira-sync"

# Local status → Jira status category name
# Actual transition names vary per project; we discover them dynamically
STATUS_LOCAL_TO_JIRA = {
    "TODO": "To Do",
    "IN_PROGRESS": "In Progress",
    "IN_REVIEW": "In Review",
    "DONE": "Done",
    "BLOCKED": "Blocked",
    "DELAYED": "Delayed",
}

STATUS_JIRA_TO_LOCAL = {}
for local, jira in STATUS_LOCAL_TO_JIRA.items():
    STATUS_JIRA_TO_LOCAL[jira.lower()] = local
# Common Jira aliases
STATUS_JIRA_TO_LOCAL.update({
    "to do": "TODO",
    "open": "TODO",
    "backlog": "TODO",
    "in progress": "IN_PROGRESS",
    "in review": "IN_REVIEW",
    "done": "DONE",
    "closed": "DONE",
    "resolved": "DONE",
    "blocked": "BLOCKED",
    "delayed": "DELAYED",
})


def keychain_get(account):
    """Read a value from macOS Keychain."""
    try:
        result = subprocess.run(
            ["security", "find-generic-password", "-s", KEYCHAIN_SERVICE, "-a", account, "-w"],
            capture_output=True, text=True, check=True,
        )
        return result.stdout.strip()
    except subprocess.CalledProcessError:
        return None


def keychain_set(account, value):
    """Store a value in macOS Keychain (update if exists)."""
    # Delete existing entry if present
    subprocess.run(
        ["security", "delete-generic-password", "-s", KEYCHAIN_SERVICE, "-a", account],
        capture_output=True,
    )
    subprocess.run(
        ["security", "add-generic-password", "-s", KEYCHAIN_SERVICE, "-a", account, "-w", value],
        check=True,
    )


def get_credentials():
    """Get Jira email and API token from Keychain."""
    email = keychain_get("email")
    token = keychain_get("api_token")
    if not email or not token:
        print("Jira credentials not found in Keychain.")
        print("Run: jira-sync setup")
        sys.exit(1)
    return email, token


_my_account_id = None

def get_my_account_id(email, token):
    """Get the current user's Jira account ID (cached)."""
    global _my_account_id
    if _my_account_id is None:
        me = jira_request("GET", "/rest/api/3/myself", email, token)
        _my_account_id = me["accountId"]
    return _my_account_id


def jira_request(method, path, email, token, data=None):
    """Make a Jira REST API request."""
    url = f"{JIRA_BASE}{path}"
    auth = b64encode(f"{email}:{token}".encode()).decode()
    headers = {
        "Authorization": f"Basic {auth}",
        "Content-Type": "application/json",
        "Accept": "application/json",
    }
    body = json.dumps(data).encode() if data else None
    req = Request(url, data=body, headers=headers, method=method)
    try:
        with urlopen(req) as resp:
            if resp.status == 204:
                return {}
            return json.loads(resp.read())
    except HTTPError as e:
        error_body = e.read().decode()
        print(f"Jira API error {e.code}: {error_body}", file=sys.stderr)
        raise


def get_journal_file(target_date=None):
    """Get the journal file path for a given date (default: today)."""
    d = target_date or date.today()
    home = Path.home()
    return home / "notes" / str(d.year) / f"{d.month:02d}" / f"{d.strftime('%Y-%m-%d')}.md"


def ensure_journal_file(filepath, target_date=None):
    """Create journal file if it doesn't exist."""
    if not filepath.exists():
        filepath.parent.mkdir(parents=True, exist_ok=True)
        d = target_date or date.today()
        filepath.write_text(
            f"# {d.strftime('%Y-%m-%d')} - {d.strftime('%A')}\n\n## Notes\n\n## Todos\n"
        )


TODO_PATTERN = re.compile(
    r"^- \[(TODO|DONE|IN_PROGRESS|IN_REVIEW|BLOCKED|DELAYED)\]\s*(?:(\w+-\d+):\s*)?(.+)$"
)

METADATA_PATTERN = re.compile(r"\s*\{([^}]+)\}\s*$")

PRIORITY_TO_JIRA = {
    "critical": "1",
    "high": "2",
    "medium": "3",
    "low": "4",
}


def parse_metadata(title):
    """Extract metadata block {due:..., p:..., @...} from title. Returns (clean_title, metadata)."""
    metadata = {}
    m = METADATA_PATTERN.search(title)
    if m:
        title = title[:m.start()]
        for part in m.group(1).split(","):
            part = part.strip()
            if part.startswith("due:"):
                metadata["due_date"] = part[4:]
            elif part.startswith("p:"):
                metadata["priority"] = part[2:]
            elif part.startswith("@"):
                metadata["assignee"] = part[1:]
    return title.strip(), metadata


def parse_todos(filepath):
    """Parse todos from journal file. Returns list of dicts."""
    todos = []
    lines = filepath.read_text().splitlines()
    for i, line in enumerate(lines):
        m = TODO_PATTERN.match(line.strip())
        if m:
            raw_title = m.group(3)
            clean_title, metadata = parse_metadata(raw_title)
            # Check if next line is a description sub-bullet
            description = None
            if i + 1 < len(lines):
                next_line = lines[i + 1].strip()
                if next_line.startswith("- ") and not TODO_PATTERN.match(next_line):
                    description = next_line[2:]
            todos.append({
                "line_num": i,
                "status": m.group(1),
                "jira_key": m.group(2),
                "title": clean_title,
                "metadata": metadata,
                "description": description,
                "raw": line,
            })
    return todos


def update_journal_line(filepath, line_num, new_line):
    """Replace a specific line in the journal file."""
    lines = filepath.read_text().splitlines()
    lines[line_num] = new_line
    filepath.write_text("\n".join(lines) + "\n")


def append_todo(filepath, status, jira_key, title):
    """Append a todo to the journal file."""
    entry = f"- [{status}] {jira_key}: {title}"
    content = filepath.read_text()
    if not content.endswith("\n"):
        content += "\n"
    content += entry + "\n"
    filepath.write_text(content)


def get_jira_transition(email, token, issue_key, target_status_name):
    """Find the transition ID to move an issue to a target status."""
    transitions = jira_request("GET", f"/rest/api/3/issue/{issue_key}/transitions", email, token)
    target_lower = target_status_name.lower()
    for t in transitions.get("transitions", []):
        if t["to"]["name"].lower() == target_lower:
            return t["id"]
    # Fuzzy match
    for t in transitions.get("transitions", []):
        if target_lower in t["to"]["name"].lower() or t["to"]["name"].lower() in target_lower:
            return t["id"]
    return None


def sync_push(email, token, filepath, dry_run=False):
    """Push local todos to Jira (create new issues, sync status changes)."""
    todos = parse_todos(filepath)
    created = 0
    updated = 0

    for todo in todos:
        if todo["jira_key"]:
            # Existing issue — sync status local → Jira
            target_jira_status = STATUS_LOCAL_TO_JIRA.get(todo["status"])
            if not target_jira_status:
                continue

            # Get current Jira status
            try:
                issue = jira_request("GET", f"/rest/api/3/issue/{todo['jira_key']}", email, token)
            except HTTPError:
                print(f"  ! Could not fetch {todo['jira_key']}, skipping")
                continue

            current_jira_status = issue["fields"]["status"]["name"]
            if current_jira_status.lower() != target_jira_status.lower():
                if dry_run:
                    print(f"  [dry-run] Would transition {todo['jira_key']}: {current_jira_status} → {target_jira_status}")
                else:
                    tid = get_jira_transition(email, token, todo["jira_key"], target_jira_status)
                    if tid:
                        jira_request("POST", f"/rest/api/3/issue/{todo['jira_key']}/transitions", email, token, {"transition": {"id": tid}})
                        print(f"  -> {todo['jira_key']}: {current_jira_status} → {target_jira_status}")
                        updated += 1
                    else:
                        print(f"  ! No transition found for {todo['jira_key']} → {target_jira_status}")
        else:
            # New local todo — create Jira issue
            if dry_run:
                print(f"  [dry-run] Would create issue: {todo['title']}")
            else:
                fields = {
                    "project": {"key": JIRA_PROJECT},
                    "summary": todo["title"],
                    "issuetype": {"name": "Task"},
                    "assignee": {"accountId": get_my_account_id(email, token)},
                }
                meta = todo.get("metadata", {})
                if todo.get("description"):
                    fields["description"] = {
                        "type": "doc", "version": 1,
                        "content": [{"type": "paragraph", "content": [{"type": "text", "text": todo["description"]}]}],
                    }
                if meta.get("due_date"):
                    fields["duedate"] = meta["due_date"]
                if meta.get("priority") and meta["priority"] in PRIORITY_TO_JIRA:
                    fields["priority"] = {"id": PRIORITY_TO_JIRA[meta["priority"]]}
                if meta.get("assignee"):
                    fields["assignee"] = {"accountId": meta["assignee"]}

                try:
                    result = jira_request("POST", "/rest/api/3/issue", email, token, {"fields": fields})
                    jira_key = result["key"]
                    # Reconstruct the line with jira key, preserving metadata block
                    meta_block = METADATA_PATTERN.search(todo["raw"])
                    meta_suffix = meta_block.group(0) if meta_block else ""
                    new_line = f"- [{todo['status']}] {jira_key}: {todo['title']}{meta_suffix}"
                    update_journal_line(filepath, todo["line_num"], new_line)
                    print(f"  + Created {jira_key}: {todo['title']}")
                    created += 1
                except HTTPError:
                    print(f"  ! Failed to create issue for: {todo['title']}")

    return created, updated


def jira_search_all(email, token, jql, fields):
    """Paginated Jira search — fetches all matching issues."""
    all_issues = []
    next_page_token = None
    page_size = 100
    while True:
        body = {"jql": jql, "maxResults": page_size, "fields": fields}
        if next_page_token:
            body["nextPageToken"] = next_page_token
        results = jira_request("POST", "/rest/api/3/search/jql", email, token, body)
        issues = results.get("issues", [])
        all_issues.extend(issues)
        next_page_token = results.get("nextPageToken")
        if not next_page_token or not issues:
            break
    return all_issues


def sync_pull(email, token, filepath, dry_run=False):
    """Pull Jira issues into local journal."""
    todos = parse_todos(filepath)
    existing_keys = {t["jira_key"] for t in todos if t["jira_key"]}

    jql = f"project = {JIRA_PROJECT} AND resolution = Unresolved ORDER BY updated DESC"
    issues = jira_search_all(email, token, jql, ["summary", "status"])

    added = 0
    status_updates = 0

    for issue in issues:
        key = issue["key"]
        summary = issue["fields"]["summary"]
        jira_status = issue["fields"]["status"]["name"].lower()
        local_status = STATUS_JIRA_TO_LOCAL.get(jira_status, "TODO")

        if key not in existing_keys:
            if dry_run:
                print(f"  [dry-run] Would add: [{local_status}] {key}: {summary}")
            else:
                append_todo(filepath, local_status, key, summary)
                print(f"  + Pulled {key}: {summary} [{local_status}]")
                added += 1
        else:
            # Check for status drift (Jira → local)
            for todo in todos:
                if todo["jira_key"] == key and todo["status"] != local_status:
                    if dry_run:
                        print(f"  [dry-run] Would update {key}: {todo['status']} → {local_status}")
                    else:
                        new_line = f"- [{local_status}] {key}: {todo['title']}"
                        update_journal_line(filepath, todo["line_num"], new_line)
                        print(f"  ~ {key}: {todo['status']} → {local_status}")
                        status_updates += 1

    return added, status_updates


def carry_forward(target_filepath, lookback_days=7):
    """Scan recent journals for open todos not in target file, copy them forward."""
    target_todos = parse_todos(target_filepath)
    target_keys = {t["jira_key"] for t in target_todos if t["jira_key"]}
    target_titles = {t["title"] for t in target_todos}

    today = date.today()
    carried = 0

    for days_ago in range(1, lookback_days + 1):
        past_date = today - timedelta(days=days_ago)
        past_file = get_journal_file(past_date)
        if not past_file.exists():
            continue

        past_todos = parse_todos(past_file)
        for todo in past_todos:
            if todo["status"] in ("DONE",):
                continue
            if todo["jira_key"] and todo["jira_key"] in target_keys:
                continue
            if not todo["jira_key"] and todo["title"] in target_titles:
                continue
            # Carry forward
            if todo["jira_key"]:
                append_todo(target_filepath, todo["status"], todo["jira_key"], todo["title"])
                target_keys.add(todo["jira_key"])
            else:
                meta_block = METADATA_PATTERN.search(todo["raw"])
                meta_suffix = meta_block.group(0) if meta_block else ""
                entry = f"- [{todo['status']}] {todo['title']}{meta_suffix}"
                content = target_filepath.read_text()
                if not content.endswith("\n"):
                    content += "\n"
                content += entry + "\n"
                if todo.get("description"):
                    content += f"  - {todo['description']}\n"
                target_filepath.write_text(content)
                target_titles.add(todo["title"])
            print(f"  >> Carried from {past_date}: [{todo['status']}] {todo.get('jira_key', '')}: {todo['title']}")
            carried += 1

    return carried


def resolve_date(date_str):
    """Parse a date string like '2026-05-14', 'yesterday', 'today'."""
    if date_str in (None, "today"):
        return date.today()
    if date_str == "yesterday":
        return date.today() - timedelta(days=1)
    try:
        parts = date_str.split("-")
        return date(int(parts[0]), int(parts[1]), int(parts[2]))
    except (ValueError, IndexError):
        print(f"Invalid date: {date_str}. Use YYYY-MM-DD, 'today', or 'yesterday'.")
        sys.exit(1)


def cmd_setup(args):
    """Store Jira credentials in Keychain."""
    import getpass
    email = input("Jira email: ").strip()
    token = getpass.getpass("Jira API token: ").strip()
    keychain_set("email", email)
    keychain_set("api_token", token)
    print("Credentials stored in macOS Keychain.")
    # Verify
    try:
        jira_request("GET", "/rest/api/3/myself", email, token)
        print("Verified: connected to Jira successfully.")
    except Exception as e:
        print(f"Warning: could not verify connection: {e}")


def cmd_sync(args):
    """Full two-way sync."""
    email, token = get_credentials()
    target_date = resolve_date(getattr(args, "date", None))
    filepath = get_journal_file(target_date)
    ensure_journal_file(filepath, target_date)

    print(f"Syncing {filepath.name} <-> Jira {JIRA_PROJECT}")
    print()

    if target_date == date.today():
        print("Carrying forward open todos from recent days...")
        carried = carry_forward(filepath)
        if carried:
            print(f"  {carried} carried forward")
        print()

    print("Pulling from Jira...")
    pulled, pull_updates = sync_pull(email, token, filepath, dry_run=args.dry_run)

    # Re-read file after pull modifications
    print("Pushing to Jira...")
    pushed, push_updates = sync_push(email, token, filepath, dry_run=args.dry_run)

    print()
    prefix = "[dry-run] " if args.dry_run else ""
    print(f"{prefix}Pull: {pulled} added, {pull_updates} status updates")
    print(f"{prefix}Push: {pushed} created, {push_updates} status updates")


def cmd_push(args):
    """Push local changes to Jira."""
    email, token = get_credentials()
    target_date = resolve_date(getattr(args, "date", None))
    filepath = get_journal_file(target_date)
    ensure_journal_file(filepath, target_date)
    print(f"Pushing {filepath.name} -> Jira {JIRA_PROJECT}")
    created, updated = sync_push(email, token, filepath, dry_run=args.dry_run)
    prefix = "[dry-run] " if args.dry_run else ""
    print(f"{prefix}{created} created, {updated} status updates")


def cmd_pull(args):
    """Pull Jira issues to journal."""
    email, token = get_credentials()
    target_date = resolve_date(getattr(args, "date", None))
    filepath = get_journal_file(target_date)
    ensure_journal_file(filepath, target_date)
    print(f"Pulling Jira {JIRA_PROJECT} -> {filepath.name}")
    added, updates = sync_pull(email, token, filepath, dry_run=args.dry_run)
    prefix = "[dry-run] " if args.dry_run else ""
    print(f"{prefix}{added} added, {updates} status updates")


def cmd_carry_forward(args):
    """Carry forward open todos from recent days into today's journal."""
    target_date = resolve_date(getattr(args, "date", None))
    filepath = get_journal_file(target_date)
    ensure_journal_file(filepath, target_date)
    lookback = getattr(args, "days", 7)
    print(f"Carrying forward open todos into {filepath.name} (looking back {lookback} days)...")
    carried = carry_forward(filepath, lookback_days=lookback)
    print(f"{carried} todos carried forward")


def cmd_status(args):
    """Show sync status for todos."""
    email, token = get_credentials()
    target_date = resolve_date(getattr(args, "date", None))
    filepath = get_journal_file(target_date)
    if not filepath.exists():
        print(f"No journal for {target_date}.")
        return

    todos = parse_todos(filepath)
    if not todos:
        print("No todos found.")
        return

    for todo in todos:
        jira_info = ""
        if todo["jira_key"]:
            try:
                issue = jira_request("GET", f"/rest/api/3/issue/{todo['jira_key']}?fields=status", email, token)
                jira_status = issue["fields"]["status"]["name"]
                synced = "synced" if STATUS_JIRA_TO_LOCAL.get(jira_status.lower()) == todo["status"] else "DRIFT"
                jira_info = f" | Jira: {jira_status} ({synced})"
            except HTTPError:
                jira_info = " | Jira: ERROR"
        else:
            jira_info = " | not linked"
        print(f"  [{todo['status']}] {todo.get('jira_key', '???')}: {todo['title']}{jira_info}")


def main():
    parser = argparse.ArgumentParser(description="Sync journal todos with Jira")
    sub = parser.add_subparsers(dest="command")

    sub.add_parser("setup", help="Configure Jira credentials")
    for name in ("sync", "push", "pull", "status"):
        p = sub.add_parser(name, help=f"{name.capitalize()} operation")
        p.add_argument("--dry-run", "-n", action="store_true", help="Show what would happen without making changes")
        p.add_argument("--date", "-d", default=None, help="Target date: YYYY-MM-DD, 'yesterday', or 'today' (default)")

    cf = sub.add_parser("carry-forward", help="Carry open todos from recent days into target journal")
    cf.add_argument("--date", "-d", default=None, help="Target date (default: today)")
    cf.add_argument("--days", type=int, default=7, help="How many days back to scan (default: 7)")

    args = parser.parse_args()
    if not args.command:
        args.command = "sync"
        args.dry_run = False
        args.date = None

    dispatch = {
        "setup": cmd_setup,
        "sync": cmd_sync,
        "push": cmd_push,
        "pull": cmd_pull,
        "status": cmd_status,
        "carry-forward": cmd_carry_forward,
    }
    dispatch[args.command](args)


if __name__ == "__main__":
    main()
